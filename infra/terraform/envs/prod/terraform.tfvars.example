# terraform.tfvars 로 복사해 값을 채운 뒤 사용한다. (terraform.tfvars 는 gitignore 됨)
#
# 배포 절차:
#   0. bootstrap/ 에서 state 버킷 생성 후 backend.tf 의 bucket 교체 (bootstrap/main.tf 주석 참고)
#   1. terraform init && terraform plan && terraform apply
#      - 최초 apply 는 backend_desired_count = 0 (ECR에 이미지가 아직 없으므로)
#   2. backend 이미지를 빌드해 ECR에 push (ecr_repository_url 출력 참조, arm64 빌드)
#   3. backend_autoscaling_enabled = true 로 바꿔 재-apply
#      → 오토스케일링 min(2)이 태스크를 띄운다. 온디맨드 1 + Spot 증설, CPU 60% 기준 2~10대
#      (desired_count는 ignore_changes라 재-apply로는 바뀌지 않음)
#   4. frontend 빌드(VITE_API_URL=https://admin-api.<domain> — admin_api_url 출력 참조) 후
#      frontend_bucket_name 버킷에 sync + CloudFront invalidation
#
# 진입점이 둘이다 (이유는 루트 context-notes.md):
#   api.<domain>       → NLB :80  평문. 매체·트래커에 배포된 트래킹·포스트백 링크 전용
#   admin-api.<domain> → ALB :443 HTTPS. 프론트가 호출하는 어드민 API
#   api 쪽으로 어드민 경로를 부르면 앱이 404를 준다 (apps/backend/src/main.ts의 공개 경로 목록)
#
# 수동 작업 (Terraform 범위 밖):
#   - SES 도메인 identity·DKIM (레거시가 만들어 둔 것을 그대로 사용 — Terraform 관리 대상 아님)
#   - SES 샌드박스 해제 신청 (이미 해제돼 있다면 불필요)
#   - backend CORS 허용 origin에 https://admin.<domain> 추가 (apps/backend/src/main.ts)

domain_name    = "example.com"
ses_from_email = "no-reply@example.com"

# api.<domain>·admin.<domain>은 레거시가 운영 중이라 레코드 생성이 곧 컷오버다.
# false인 동안은 두 레코드를 만들지 않으므로 레거시가 계속 트래픽을 받고,
# 신규 스택은 nlb_dns_name·alb_dns_name·CloudFront 도메인으로 직접 검증한다.
# 컷오버 시점에 true로 바꿔 재-apply할 것.
# cutover_dns_enabled = false

# DB·캐시에 사람이 붙어야 할 때만 true (데이터 이관·수동 조회). 끝나면 false로 되돌릴 것.
# bastion_enabled       = false

# frontend_subdomain    = "admin"
# api_subdomain         = "api"
# admin_api_subdomain   = "admin-api"
# backend_desired_count = 0
# image_tag             = "latest"

# 스트림 버퍼 깊이 = redis_stream_maxlen / 초당 유입량. 컨슈머가 이보다 오래 밀리면
# 미소비 메시지가 트림된다. 유입량이 예상보다 크면 올릴 것 (variables.tf 사이징 근거 참고)
# redis_stream_maxlen   = 2000000
