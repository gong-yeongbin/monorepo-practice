// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(60)
  role       Role     @default(USER)
  approved   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  user_advertising user_advertising[]
}

// 유저가 볼 수 있는 광고 허용 목록(M:N). 행이 없으면 아무 광고도 보이지 않는다(전체 허용 아님).
// 가입 승인 시 PATCH /users/:id의 advertising_ids로 통째 교체한다. DEVELOPER·ADMIN은 스코핑 면제라 행을 두지 않는다.
model user_advertising {
  user           user        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id        Int         @db.Integer
  advertising    advertising @relation(fields: [advertising_id], references: [id], onDelete: Cascade)
  advertising_id Int         @db.Integer

  @@id([user_id, advertising_id])
  // 복합 PK 인덱스는 선두 컬럼(user_id)만 커버하고 PostgreSQL은 FK 인덱스를 자동 생성하지 않는다.
  // advertising 삭제 시 cascade가 이 인덱스를 탄다.
  @@index([advertising_id])
}

model advertiser {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(30)

  advertising advertising[]
}

model tracker {
  id                   Int    @id @default(autoincrement())
  name                 String @unique @db.VarChar(30)
  tracking_url         String @db.Text
  install_postback_url String @db.Text
  event_postback_url   String @db.Text

  advertising advertising[]
}

model advertising {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(30)
  image String? @db.Text

  advertiser    advertiser @relation(fields: [advertiser_id], references: [id], onUpdate: Cascade)
  advertiser_id Int        @db.Integer
  tracker       tracker    @relation(fields: [tracker_id], references: [id], onUpdate: Cascade)
  tracker_id    Int        @db.Integer

  campaign         campaign[]
  user_advertising user_advertising[]
}

model campaign {
  id                   Int     @id @default(autoincrement())
  token                String  @unique @default(uuid()) @db.VarChar(36)
  name                 String  @db.VarChar(30)
  type                 Type
  is_active            Boolean @default(true)
  tracker_name         String  @db.Text
  tracker_tracking_url String  @db.Text

  advertising    advertising @relation(fields: [advertising_id], references: [id], onUpdate: Cascade)
  advertising_id Int         @db.Integer
  media          media       @relation(fields: [media_id], references: [id], onUpdate: Cascade)
  media_id       Int         @db.Integer

  campaign_config campaign_config[]
  daily_report    daily_report[]
  reservation     reservation[]
}

model media {
  id                   Int    @id @default(autoincrement())
  name                 String @unique @db.VarChar(30)
  install_postback_url String @db.Text
  event_postback_url   String @db.Text

  campaign campaign[]
}

model campaign_config {
  id                 Int      @id @default(autoincrement())
  campaign           campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  campaign_id        Int      @db.Integer
  send_media         Boolean  @default(true)
  tracker_event_name String   @default("install") @db.VarChar(50)
  admin_event_name   String   @default("install") @db.VarChar(50)
  media_event_name   String   @default("install") @db.VarChar(50)

  @@unique([campaign_id, admin_event_name])
}

// 상위 트래커 URL 예약 변경. 선택한 캠페인마다 개별 행으로 저장하고, 실행(스케줄러)은 is_applied로 상태를 남긴다
model reservation {
  id           Int      @id @default(autoincrement())
  campaign     campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  campaign_id  Int      @db.Integer
  name         String   @db.VarChar(30)
  tracking_url String   @db.Text
  reserved_at  DateTime @db.Timestamp(0)
  is_applied   Boolean  @default(false)
}

model postback {
  id               BigInt    @id @default(autoincrement())
  tracker_name     String    @db.VarChar(30)
  event_name       String    @db.VarChar(100)
  click_id         String    @db.VarChar(100)
  pub_id           String?   @db.VarChar(255)
  sub_id           String?   @db.VarChar(255)
  // view_code는 AES(`token:pub_id:sub_id`)를 base64+URL 인코딩한 파생값이라 길이가 두 가변 입력에 딸려 늘어난다.
  // 고정 폭을 두면 긴 sub_id에서 저장이 깨지므로(VarChar(255)였을 때 실제로 초과) 상한을 두지 않는다.
  view_code        String    @db.Text
  token            String    @db.VarChar(100)
  adid             String?   @db.VarChar(50)
  idfa             String?   @db.VarChar(50)
  ip               String    @db.VarChar(30)
  country_code     String?   @db.VarChar(10)
  clicked_at       DateTime? @db.Timestamp(0)
  installed_at     DateTime? @db.Timestamp(0)
  evented_at       DateTime? @db.Timestamp(0)
  media_sent_at    DateTime? @db.Timestamp(0)
  revenue_currency String?   @db.VarChar(10)
  // revenue는 트래커 원본 문자열을 손실 없이 보존한다(소수·통화 혼재 가능). 집계용 daily_report.revenue(Int)와 타입이 다른 것은 의도적이다.
  revenue          String?   @db.VarChar(50)
  raw_query_params String    @db.Text
  // 이 서버가 포스트백을 받아 저장한 시각. 트래커가 보내온 이벤트 발생 시각(clicked_at·installed_at·evented_at)과 달리
  // 항상 채워지고 이벤트 종류에 따라 갈리지 않는다. 값은 DB default로 채우므로 앱에서 넣지 않는다.
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  // 어드민 로그 조회(인스톨·이벤트·미등록 모달)용 인덱스. 삽입 전용이던 설계에 조회 API가 추가되면서 도입했다.
  @@index([token, installed_at])
  @@index([token, evented_at])
  @@index([view_code])
}

model daily_report {
  id           BigInt   @id @default(autoincrement())
  // view_code는 AES(`token:pub_id:sub_id`)를 base64+URL 인코딩한 파생값이라 길이가 두 가변 입력에 딸려 늘어난다.
  // 고정 폭을 두면 긴 sub_id에서 저장이 깨지므로(VarChar(255)였을 때 실제로 초과) 상한을 두지 않는다.
  view_code    String   @db.Text
  // 관계를 campaign_id(PK)가 아니라 token으로 연결한다. tracking consumer가 클릭 집계 시 campaign을 조회하지 않고 viewCode에서 디코드한 token만으로 upsert하기 위한 의도적 설계다(핫패스 DB 조회 회피).
  campaign     campaign @relation(fields: [token], references: [token])
  token        String   @db.VarChar(100)
  pub_id       String?  @db.VarChar(255)
  sub_id       String?  @db.VarChar(255)
  click        Int      @default(0)
  install      Int      @default(0)
  registration Int      @default(0)
  retention    Int      @default(0)
  purchase     Int      @default(0)
  revenue      Int      @default(0)
  etc1         Int      @default(0)
  etc2         Int      @default(0)
  etc3         Int      @default(0)
  etc4         Int      @default(0)
  etc5         Int      @default(0)
  unregistered Int      @default(0)
  created_date DateTime @db.Date()

  @@unique([view_code, created_date])
  // 대시보드 집계 조회용 인덱스. 위 unique는 선두가 view_code라 created_date·token 조회에 쓰이지 않는다.
  // [created_date]는 일자/기간 전체 합산(dashboard·daily·detail), [token, created_date]는 캠페인 한정 조회(dailyDetail·daily)를 받는다.
  // token은 FK지만 PostgreSQL이 FK 인덱스를 자동 생성하지 않아 직접 둔다.
  @@index([created_date])
  @@index([token, created_date])
}

enum Role {
  DEVELOPER
  ADMIN
  USER
}

enum Type {
  CPI
  CPA
}
